# User build extensions (not generated by MCC/MPLAB).
# Included after .generated/main.cmake — generated targets already exist.
#
# lely-core sources are listed in:
#   - .vscode/gateway_abstract_layer.mplab.json (fileSet)
#   - .generated/file.cmake (after MPLAB CMake generate)
# This file only adds include paths and preprocessor macros.

set(GATEWAY_SRC_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../src")
set(GATEWAY_TP_ROOT  "${CMAKE_CURRENT_LIST_DIR}/../../../third_party")
set(LELY_ROOT        "${GATEWAY_TP_ROOT}/lely-core")
set(LELY_CFG_DIR     "${GATEWAY_SRC_ROOT}/software_core/canopen/config")

set(GATEWAY_USER_INCLUDE_DIRS
    "${GATEWAY_SRC_ROOT}"
    "${GATEWAY_SRC_ROOT}/abstract_layer/interface"
    "${GATEWAY_SRC_ROOT}/software_core/interface"
    "${GATEWAY_SRC_ROOT}/software_core/core"
    "${GATEWAY_SRC_ROOT}/software_core/canopen"
    "${GATEWAY_SRC_ROOT}/software_core/ethercat"
    "${GATEWAY_SRC_ROOT}/interface"
    "${LELY_ROOT}/include"
    "${LELY_CFG_DIR}"
    "${LELY_ROOT}/lib/co"
    "${LELY_ROOT}/lib/can"
    "${LELY_ROOT}/lib/util"
    "${LELY_ROOT}/lib/compat"
)

# LELY_NO_MALLOC must be visible before gateway_od.c's early #error check.
set(LELY_COMPILE_DEFS
    HAVE_CONFIG_H=1
    LELY_NO_MALLOC=1
    LELY_HAVE_TIMESPEC=1
    LELY_HAVE_ITIMERSPEC=1
)

if(TARGET gateway_abstract_layer_default_default_XC32_compile)
    target_include_directories(gateway_abstract_layer_default_default_XC32_compile
        PRIVATE ${GATEWAY_USER_INCLUDE_DIRS})

    target_compile_definitions(gateway_abstract_layer_default_default_XC32_compile
        PRIVATE ${LELY_COMPILE_DEFS})
endif()
