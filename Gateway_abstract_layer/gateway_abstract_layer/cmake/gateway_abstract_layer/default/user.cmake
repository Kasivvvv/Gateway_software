# User build extensions (not generated by MCC/MPLAB).
# Included after .generated/main.cmake — generated targets already exist.
#
# Sources under src/ are compiled via the MPLAB file-set glob.
# This file only adds include directories.

set(GATEWAY_SRC_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../src")

set(GATEWAY_USER_INCLUDE_DIRS
    "${GATEWAY_SRC_ROOT}"
    "${GATEWAY_SRC_ROOT}/abstract_layer/interface"
    "${GATEWAY_SRC_ROOT}/software_core/interface"
    "${GATEWAY_SRC_ROOT}/software_core/core"
    "${GATEWAY_SRC_ROOT}/interface"
)

if(TARGET gateway_abstract_layer_default_default_XC32_compile)
    target_include_directories(gateway_abstract_layer_default_default_XC32_compile
        PRIVATE ${GATEWAY_USER_INCLUDE_DIRS})
endif()
