{
    "version": "1.9",
    "configurations": [
        {
            "name": "default",
            "id": "",
            "device": "ATSAMV71Q21B",
            "imagePath": "./out/gateway_abstract_layer/default.elf",
            "toolProperties": "default-tool-base",
            "tool": "Simulator",
            "packs": [
                {
                    "name": "SAMV71_DFP",
                    "version": "4.13.257",
                    "vendor": "Microchip"
                },
                {
                    "name": "CMSIS",
                    "version": "6.3.0",
                    "vendor": "ARM"
                }
            ],
            "fileSet": "default",
            "toolchain": "default-XC32",
            "userVariables": "default-uservariables"
        }
    ],
    "propertyGroups": [
        {
            "name": "default-uservariables",
            "type": "uservariables",
            "properties": {}
        },
        {
            "name": "default-XC32",
            "type": "toolchain",
            "provider": "microchip.toolchains:xc32@5.10",
            "properties": {
                "linker.heap-size": "512",
                "compiler.extra-include-directories": [
                    "config.mcc/src",
                    "config.mcc/src/config/default",
                    "config.mcc/src/config/default/library",
                    "config.mcc/src/config/default/library/tcpip/src",
                    "config.mcc/src/config/default/library/tcpip/src/common",
                    "config.mcc/src/packs/ATSAMV71Q21B_DFP",
                    "config.mcc/src/packs/CMSIS",
                    "config.mcc/src/packs/CMSIS/CMSIS/Core/Include",
                    "src",
                    "src/abstract_layer/interface",
                    "src/interface",
                    "src/software_core/canopen",
                    "src/software_core/canopen/config",
                    "src/software_core/core",
                    "src/software_core/ethercat",
                    "src/software_core/interface",
                    "third_party/lely-core/include",
                    "third_party/lely-core/lib/can",
                    "third_party/lely-core/lib/co",
                    "third_party/lely-core/lib/compat",
                    "third_party/lely-core/lib/util"
                ],
                "compiler++.extra-include-directories": [
                    "config.mcc/src",
                    "config.mcc/src/config/default",
                    "config.mcc/src/packs/ATSAMV71Q21B_DFP",
                    "config.mcc/src/packs/CMSIS",
                    "config.mcc/src/packs/CMSIS/CMSIS/Core/Include",
                    "src",
                    "third_party/lely-core/include"
                ],
                "compiler.preprocessor-macros": [
                    "HAVE_CONFIG_H=1",
                    "LELY_NO_MALLOC=1",
                    "LELY_HAVE_TIMESPEC=1",
                    "LELY_HAVE_ITIMERSPEC=1"
                ],
                "linker.no-device-startup-code": "true",
                "C32Global.mstacktcm": "false",
                "compiler.isolate-each-function": "true",
                "compiler.optimization-level": "-O1",
                "compiler.place-data-into-section": "true",
                "linker.remove-unused-sections": "true",
                "compiler++.isolate-each-function": "true",
                "compiler++.optimization-level": "-O1"
            }
        },
        {
            "name": "default-tool-base",
            "type": "tool",
            "properties": {}
        },
        {
            "name": "default-debug",
            "type": "debug",
            "provider": "microchip.mplab-core-da:DebugPropertyGroup",
            "properties": {
                "useOnDemandDebugStrategy": true
            }
        }
    ],
    "fileSets": [
        {
            "name": "default",
            "files": [
                {
                    "include": "**/*",
                    "exclude": "**/@(build|_build|out|cmake|.vscode|tests|third_party|tools|.venv-dcf)/**/*"
                },
